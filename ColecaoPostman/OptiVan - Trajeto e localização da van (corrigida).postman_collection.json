        {
          "name": "Login motorista",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login retorna 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Devolve token e usuário\", () => { pm.expect(body.token).to.be.a(\"string\"); pm.expect(body.user.id).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"tokenMotorista\", body.token);",
                  "pm.collectionVariables.set(\"motoristaId\", body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
